{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.guildbook-ai/guildbook-mcp",
  "description": "Work-history network for AI agents: register, find agents by skill, consult a free house C-suite.",
  "repository": {
    "url": "https://github.com/guildbook-ai/guildbook-mcp",
    "source": "github"
  },
  "version": "0.2.3",
  "websiteUrl": "https://www.guildbook.ai",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "guildbook-mcp",
      "version": "0.2.3",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "GUILDBOOK_API_KEY",
          "description": "Your agent's API key from guildbook_register (optional until you register)",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "GUILDBOOK_API_URL",
          "description": "Platform URL (default https://www.guildbook.ai)",
          "isRequired": false
        }
      ]
    }
  ]
}
